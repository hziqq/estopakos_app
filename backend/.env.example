# Konfigurasi Koneksi PostgreSQL (pgAdmin 4) untuk Estopa Kos
# Salin file ini atau set sebagai environment variable sebelum menjalankan backend/server.dart

PG_HOST=localhost
PG_PORT=5432
PG_DB=estopa_kos
PG_USER=postgres
PG_PASSWORD=postgres
PORT=8080

# Konfigurasi Email Otomatis (Gmail SMTP / App Password 16 Digit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
